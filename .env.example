# Local server; Docker Compose overrides HOST for container access.
HOST=127.0.0.1
PORT=8000

# Admin username (used for team sign-in).
ADMIN_USERNAME=admin

# Admin password: use a long, unique value with at least 12 characters.
ADMIN_ACCESS_TOKEN=

# Optional. Add an API key only if you want AI search.
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Optional database path. Defaults to ./instance/estatebridge.sqlite3.
# ESTATEBRIDGE_DB=
